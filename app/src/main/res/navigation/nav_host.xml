<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_host"
    app:startDestination="@id/countoryShow">

    <fragment
        android:id="@+id/countoryShow"
        android:name="com.example.globalinfocountries.presentation.main.CountryShow"
        android:label="Countries"
        tools:layout="@layout/fragment_countory_show"

        >
        <action
            android:id="@+id/action_countoryShow_to_newsShow"
            app:destination="@id/newsShow" />
    </fragment>
    <fragment
        android:id="@+id/newsShow"
        android:name="com.example.globalinfocountries.presentation.main.NewsShow"
        android:label="News"
        tools:layout="@layout/fragment_news_show" >
        <argument
            android:name="codeCountry"
            app:argType="string"
            />
    </fragment>
</navigation>